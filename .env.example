# ------------------------------------------------------------------
# Indian Alpha — environment template. Copy to .env and fill in.
# NEVER commit the real .env. Keys stay server-side only.
# ------------------------------------------------------------------

# --- App ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# --- FreeLLM / AI Gateway ---
# Keys are used ONLY server-side, never exposed to the frontend.
FREELLM_API_BASE=https://api.freellm.example/v1
FREELLM_API_KEY=replace_me
# Configurable model roles (do NOT hard-code models in app logic)
LLM_MODEL_FAST=replace_me
LLM_MODEL_REASONING=replace_me
LLM_MODEL_JUDGE=replace_me

# --- Datastores ---
DATABASE_URL=postgresql+psycopg://alpha:alpha@localhost:5432/indian_alpha
REDIS_URL=redis://localhost:6379/0
DUCKDB_PATH=./data/research.duckdb

# --- Market / data sources (prefer legal APIs / licensed feeds) ---
MARKET_DATA_PROVIDER=replace_me
MARKET_DATA_API_KEY=replace_me
NEWS_API_KEY=replace_me
WEB_SEARCH_API_KEY=replace_me

# --- Alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Safety switches (keep broker writes OFF) ---
BROKER_WRITE_ENABLED=false
