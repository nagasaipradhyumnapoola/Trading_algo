# ------------------------------------------------------------------
# Indian Alpha — environment template. Copy to .env and fill real values.
# NEVER commit the real .env. Keys are server-side only, never shipped to the UI.
#
# APP_MODE=demo  -> synthetic universe + mock LLM (safe, offline).
# APP_MODE=real  -> requires real datastores + market data + FreeLLMAPI below;
#                   the app FAILS FAST at startup if any required value is blank.
# ------------------------------------------------------------------

# --- App ---
APP_MODE=demo
APP_ENV=
API_HOST=
API_PORT=
LOG_LEVEL=

# --- Datastores ---
DATABASE_URL=
REDIS_URL=
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_BUCKET=
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=

# --- Market data (required in real mode) ---
MARKET_DATA_PROVIDER=
MARKET_DATA_BASE_URL=
MARKET_DATA_API_KEY=
MARKET_DATA_WS_URL=
MARKET_DATA_SYMBOL_FORMAT=

# --- Research sources ---
NEWS_PROVIDER=
NEWS_API_KEY=
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
EXCHANGE_FILINGS_PROVIDER=
EXCHANGE_FILINGS_API_KEY=

# --- FreeLLMAPI (required in real mode; routed only via the internal LLMGateway) ---
FREELLM_API_BASE=
FREELLM_API_KEY=
FREELLM_MODEL_FAST=
FREELLM_MODEL_REASONING=
FREELLM_MODEL_JUDGE=

# --- Alerts ---
ALERTS_ENABLED=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_SMTP_URL=
EMAIL_FROM=
EMAIL_TO=

# --- Risk / sizing policy ---
DEFAULT_CAPITAL=
MAX_POSITION_PCT=
MAX_PORTFOLIO_RISK_PCT=
MAX_SECTOR_PCT=
MAX_DAILY_LOSS_PCT=
MIN_AVG_DAILY_TURNOVER=
MAX_SPREAD_BPS=

# --- Safety (must stay false; the app refuses to start if true) ---
BROKER_WRITE_ENABLED=false
